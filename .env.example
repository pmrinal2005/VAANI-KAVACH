# Copy to .env.local for local work. In Vercel, set these under Project -> Settings -> Environment Variables.
# NEVER commit real values. Every key below is server-side only; none is exposed to the browser.

# --- Gnani (STT / TTS / voice clone). Base URL is the documented https://api.vachana.ai
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_FORMAT=transcribe
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani

# --- Session / signing / admin (generate each with: openssl rand -hex 32)
SESSION_SECRET=
SIGNING_KEY_HEX=
ADMIN_TOKEN=

# --- Durable state (required for live voice on Vercel; memory store is per-instance)
STORE_BACKEND=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Approved cloned voice (closed enrolment; leave consent as "revoked" until a consenting adult is enrolled)
CLONE_ENABLED=true
VOICE_CONSENT_ENV=revoked
VOICE_ENC_KEY=
VOICE_EMBEDDING_ENC=

# --- Budget governor (application credit units, NOT Gnani tariffs: calibrate then set TARIFF_CALIBRATED=true)
BUDGET_POOL=public
POOL_PUBLIC_CAP=600
COST_STT=3
COST_TTS=2
COST_VC=4
COST_EMBED=6
TARIFF_CALIBRATED=false
KILL_SWITCH=false
LIVE_INFERENCE_ENABLED=true
